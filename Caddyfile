# Replace `:80` with your domain (e.g., `naveenkr.me, www.naveenkr.me`)
# once DNS A records point to your Oracle Cloud VM IP to enable automatic HTTPS.
:80 {
	root * /home/ubuntu/portfolio/public
	encode zstd gzip

	# Proxy Auth, Admin CMS, Uploaded Assets, and API to Express (port 3001)
	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}

	handle /admin* {
		reverse_proxy 127.0.0.1:3001
	}

	handle /login {
		reverse_proxy 127.0.0.1:3001
	}

	handle /uploads/* {
		reverse_proxy 127.0.0.1:3001
	}

	# Serve static Gatsby build
	handle {
		try_files {path} {path}/index.html
		file_server
	}

	# Serve Gatsby 404 page
	handle_errors {
		@404 expression `{http.error.status_code} == 404`
		rewrite @404 /404.html
		file_server
	}
}

