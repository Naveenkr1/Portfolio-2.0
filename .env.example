# Server
PORT=3001
LOCAL_REBUILD=true
GIT_AUTO_PUSH=false

# Supabase (required by api/supabase.js at startup)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
GATSBY_SUPABASE_URL=https://your-project.supabase.co
GATSBY_SUPABASE_KEY=your-supabase-anon-key

# Cloudinary (image & resume uploads from /admin)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional overrides (defaults exist in api/index.js)
ADMIN_HASH_1=
ADMIN_HASH_2=
DEPLOY_WEBHOOK_URL=

